{
  "expo": {
    "name": "Verida Vault",
    "slug": "verida-vault",
    "icon": "./assets/vault-logo.png",
    "version": "0.1.0",
    "scheme": "veridavault",
    "privacy": "unlisted",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "io.verida.vault"
    },
    "ios": {
      "bundleIdentifier": "io.verida.vault",
      "buildNumber": "0.1.0",
      "infoPlist": {
        "NSFaceIDUsageDescription": "This app uses bio authentication to secure user's private info"
      }
    },
    "entryPoint": "index.js",
    "packagerOpts": {
      "config": "metro.config.js",
      "sourceExts": [
        "expo.ts",
        "expo.tsx",
        "expo.js",
        "expo.jsx",
        "ts",
        "tsx",
        "js",
        "jsx",
        "json",
        "wasm",
        "svg"
      ]
    }
  }
}