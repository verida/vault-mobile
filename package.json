  "version": "1.0.0",
  "scripts": {
    "new:clean": "rm -rf $TMPDIR/react-* && watchman watch-del-all && rm -rf node_modules yarn.lock ios/build ios/Podfile.lock && yarn",
    "clean": "rm -rf $TMPDIR/react-* && watchman watch-del-all && yarn",
    "pod:install": "cd ios && pod install && cd ..",
    "pod:install:clean": "cd ios && rm -rf Podfile.lock && pod install --repo-update --verbose && cd ..",
    "pod:install:arm64": "cd ios && arch -x86_64 pod install && cd ..",
    "pod:install:clean:arm64": "cd ios && rm -rf Podfile.lock && arch -x86_64 pod install --repo-update --verbose && cd ..",
    "start": "watchman watch-del-all && react-native start --reset-cache",
    "android": "react-native run-android --variant=developmentDebug --appId=io.verida.vault.internal",
    "ios": "react-native run-ios --scheme 'Development'",
    "test": "jest --passWithNoTests",
    "codepush:ios": "appcenter codepush release-react -a verida.io/Vault -p ios/Wallet/Info.plist --xcode-project-file=\"./ios/Verida Vault.xcodeproj/project.pbxproj\" --description $(git rev-parse --short HEAD) -m  --sourcemap-output --output-dir ./build",
    "codepush:ios:staging": "yarn codepush:ios -d Staging",
    "codepush:ios:production": "yarn codepush:ios -d Production",
    "lint": "eslint src --ext=.js,.jsx,.ts,.tsx",
    "build-android": "cd android && ./gradlew assembleStagingRelease",
    "postinstall": "patch-package && scripts/fix-node-modules.js && rn-nodeify --install --hack --yarn && npx jetify && npx pod-install && yarn build:webapp",
    "build:webapp": "rm -rf www && cd web && yarn && CI=false yarn build && cd .. && rm -Rf www && mkdir -p www && cp -rf web/build/* www && yarn copy:webapp:android",
    "copy:webapp:android": "rm -rf android/app/src/main/assets/www && mkdir -p android/app/src/main/assets/www && cp -rf web/build/* android/app/src/main/assets/www",
    "release:android": "yarn build:webapp && yarn android --variant=stagingRelease"
  },
