  "private": true,
  "name": "@verida/vault-mobile",
  "version": "1.5.0",
  "scripts": {
    "clean": "rm -rf $TMPDIR/react-* && rm -rf node_modules ios/pods ios/build android/app/build && watchman watch-del-all && yarn",
    "pod:install": "cd ios && pod install && cd ..",
    "pod:install:clean": "cd ios && rm -rf Podfile.lock && pod install --repo-update --verbose && cd ..",
    "pod:install:arm64": "cd ios && arch -x86_64 pod install && cd ..",
    "pod:install:clean:arm64": "cd ios && rm -rf Podfile.lock && arch -x86_64 pod install --repo-update --verbose && cd ..",
    "start": "watchman watch-del-all && react-native start --reset-cache",
    "android": "react-native run-android --mode=developmentDebug --appId=io.verida.vault.internal",
    "ios": "react-native run-ios --scheme 'Development'",
    "test": "jest --passWithNoTests",
    "codepush:ios": "appcenter codepush release-react -a verida.io/Vault -p ios/Wallet/Info.plist --xcode-project-file=\"./ios/Verida Vault.xcodeproj/project.pbxproj\" --description $(git rev-parse --short HEAD) -m  --sourcemap-output --output-dir ./build",
    "codepush:ios:staging": "yarn codepush:ios -d Staging",
    "codepush:ios:production": "yarn codepush:ios -d Production",
    "codepush:android": "appcenter codepush release-react -a verida.io/Vault-Android --description $(git rev-parse --short HEAD) -m  --sourcemap-output --output-dir ./build",
    "codepush:android:staging": "yarn codepush:android -d Staging",
    "codepush:android:production": "yarn codepush:android -d Production",
    "lint": "eslint src --ext=.js,.jsx,.ts,.tsx",
    "lint:fix": "yarn lint --fix",
    "postinstall": "patch-package && scripts/fix-node-modules.js && rn-nodeify --install --hack --yarn && npx pod-install && yarn storybook:generate",
    "wc": "npx ts-node scripts/wc",
    "pay": "npx ts-node scripts/pay",
    "storybook": "yarn storybook:generate && npx ts-node scripts/storybook",
    "storybook:generate": "sb-rn-get-stories"
  },
